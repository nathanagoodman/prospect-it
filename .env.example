# ─── Database ───────────────────────────────────────────────
# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth ───────────────────────────────────────────────────
# Your production URL, no trailing slash. Used for callbacks and reset links.
NEXTAUTH_URL="https://www.prospeciq.com"
# Generate with: openssl rand -base64 32
# Rotating this signs every user out, so set it once and leave it alone.
NEXTAUTH_SECRET=""

# Google OAuth — from console.cloud.google.com
# Authorized redirect URI: https://www.prospeciq.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Admin access ───────────────────────────────────────────
# Comma-separated emails that always have admin access.
ADMIN_EMAILS="nathanagoodman@gmail.com"
# Where admin notifications are sent.
ADMIN_EMAIL="nathanagoodman@gmail.com"

# ─── Email (Resend) ─────────────────────────────────────────
# Required for password resets and signup notifications to actually send.
RESEND_API_KEY=""
EMAIL_FROM="Pro Spec IQ <noreply@prospeciq.com>"

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_GC_PRICE_ID=""
STRIPE_ELITE_PRICE_ID=""

# ─── Site ───────────────────────────────────────────────────
# Used for sitemap, robots, canonical URLs, and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.prospeciq.com"
