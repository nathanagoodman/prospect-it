generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User Model ─────────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  hashedPassword   String?
  company          String?
  phone            String?
  role             UserRole  @default(USER)
  tier             UserTier  @default(TRADE)  // GC or TRADE
  tradeType        String?   // electrical, plumbing, hvac, etc.
  enabledTrades    String[]  // trades this user works in (for toggle system)
  tosAcceptedAt    DateTime?
  privacyAcceptedAt DateTime?
  tosVersion       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Stripe
  stripeCustomerId   String?   @unique
  subscriptionPlan   SubscriptionPlan?
  subscriptionStatus SubscriptionStatus?

  // Usage tracking — powers the admin engagement view
  lastActiveAt DateTime?
  loginCount   Int       @default(0)

  accounts         Account[]
  sessions         Session[]
  bids             Bid[]
  jobs             Job[]
  clients          Client[]
  emailSequences   EmailSequence[]
  companyProfile   CompanyProfile?
  invoices         Invoice[]
  subscription     Subscription?
  activities       Activity[]
  passwordResetTokens PasswordResetToken[]

  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([subscriptionStatus])
}

enum UserRole {
  USER
  ADMIN
}

enum UserTier {
  GC
  TRADE
}

enum SubscriptionPlan {
  PRO
  GC_PRO
  GC_ELITE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// ─── Subscription ───────────────────────────────────────────
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── Client / Lead Management (CRM) ────────────────────────
model Client {
  id          String       @id @default(cuid())
  userId      String
  name        String
  company     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zip         String?
  notes       String?      @db.Text
  source      String?      // referral, website, cold-outreach, etc.
  status      LeadStatus   @default(LEAD)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bids        Bid[]
  jobs        Job[]
  emailLogs   EmailLog[]
  invoices    Invoice[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum LeadStatus {
  LEAD
  PROSPECT
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  INACTIVE
}

// ─── Bid Estimation ─────────────────────────────────────────
model Bid {
  id              String    @id @default(cuid())
  userId          String
  clientId        String?
  jobName         String
  description     String?   @db.Text
  tradeType       String    // electrical, plumbing, HVAC, general, roofing, etc.
  tradeMetrics    Json?     // trade-specific metrics (e.g., circuitCount, roofSquares, etc.)

  // Cost breakdown
  materialCost    Float     @default(0)
  laborCost       Float     @default(0)
  laborHours      Float     @default(0)
  laborRate       Float     @default(0)
  equipmentCost   Float     @default(0)
  subcontractorCost Float   @default(0)
  permitCost      Float     @default(0)
  overheadPercent Float     @default(10)
  profitPercent   Float     @default(15)
  contingencyPercent Float  @default(5)

  // Calculated totals
  subtotal        Float     @default(0)
  overhead        Float     @default(0)
  profit          Float     @default(0)
  contingency     Float     @default(0)
  totalBid        Float     @default(0)
  profitMargin    Float     @default(0) // actual margin %

  status          BidStatus @default(DRAFT)
  dueDate         DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?   @relation(fields: [clientId], references: [id])
  lineItems       BidLineItem[]
  job             Job?
  invoices        Invoice[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

enum BidStatus {
  DRAFT
  READY
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
}

model BidLineItem {
  id          String   @id @default(cuid())
  bidId       String
  category    String   // material, labor, equipment, subcontractor, permit, other
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())

  bid         Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId])
}

// ─── Job Tracking ───────────────────────────────────────────
model Job {
  id              String    @id @default(cuid())
  userId          String
  clientId        String?
  bidId           String?   @unique
  jobName         String
  description     String?   @db.Text
  tradeType       String
  address         String?
  city            String?
  state           String?
  zip             String?

  status          JobStatus @default(NOT_STARTED)
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?

  // Financials
  contractAmount  Float     @default(0)
  totalCosts      Float     @default(0)
  totalBilled     Float     @default(0)
  totalPaid       Float     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?   @relation(fields: [clientId], references: [id])
  bid             Bid?      @relation(fields: [bidId], references: [id])
  changeOrders    ChangeOrder[]
  dailyLogs       DailyLog[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  PUNCH_LIST
  COMPLETED
  CANCELLED
}

model ChangeOrder {
  id          String   @id @default(cuid())
  jobId       String
  title       String
  description String?  @db.Text
  amount      Float    @default(0)
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model DailyLog {
  id          String   @id @default(cuid())
  jobId       String
  date        DateTime
  notes       String?  @db.Text
  hoursWorked Float    @default(0)
  weather     String?
  crewSize    Int      @default(0)
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─── Email Sequences ────────────────────────────────────────
model EmailSequence {
  id          String   @id @default(cuid())
  userId      String
  name        String
  subject     String
  body        String   @db.Text
  delayDays   Int      @default(0)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id          String   @id @default(cuid())
  clientId    String
  subject     String
  body        String   @db.Text
  status      String   @default("sent") // sent, delivered, opened, bounced
  sentAt      DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ─── Waitlist ───────────────────────────────────────────────
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  trade     String?

  // CRM pipeline fields
  source          String    @default("waitlist") // waitlist | manual | referral
  stage           LeadStage @default(NEW)
  score           Int       @default(0) // 0-100, computed from engagement
  lastContactedAt DateTime?
  convertedAt     DateTime?
  convertedUserId String? // set when this lead becomes a registered User

  notes LeadNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([stage])
  @@index([createdAt])
  @@index([convertedUserId])
}

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  TRIAL
  CONVERTED
  CHURNED
}

// ─── Lead Activity Notes (CRM) ──────────────────────────────
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String   @db.Text
  type      String   @default("note") // note | email | call | status_change
  createdAt DateTime @default(now())

  lead WaitlistEntry @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

// ─── Product Usage Activity ─────────────────────────────────
// Records what users actually DO in the product, so the admin
// dashboard can show real engagement instead of guessing.
model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String // login | bid_created | job_created | invoice_created | client_created | subscription_started | subscription_canceled
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@index([createdAt])
}

// ─── Password Reset ─────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // sha256 hash of the emailed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Company Branding Profile ───────────────────────────────
model CompanyProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String?
  address         String?
  city            String?
  state           String?
  zip             String?
  phone           String?
  email           String?
  website         String?
  licenseNumber   String?
  logoBase64      String?  @db.Text
  accentColor     String   @default("#f97316")
  paymentTerms    String?  @db.Text
  defaultNotes    String?  @db.Text
  footerText      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Invoices & Estimates ───────────────────────────────────
model Invoice {
  id                String        @id @default(cuid())
  userId            String
  bidId             String?
  clientId          String?
  invoiceNumber     String
  type              InvoiceType   @default(ESTIMATE)
  status            InvoiceStatus @default(DRAFT)

  // Client info snapshot
  clientName        String
  clientEmail       String?
  clientAddress     String?
  clientCity        String?
  clientState       String?
  clientZip         String?
  clientPhone       String?

  // Project
  projectName       String
  projectDescription String?     @db.Text

  // Financial
  subtotal          Float         @default(0)
  taxRate           Float         @default(0)
  taxAmount         Float         @default(0)
  discount          Float         @default(0)
  total             Float         @default(0)

  // Dates
  issueDate         DateTime      @default(now())
  dueDate           DateTime?

  // Custom text
  notes             String?       @db.Text
  terms             String?       @db.Text

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bid               Bid?          @relation(fields: [bidId], references: [id])
  client            Client?       @relation(fields: [clientId], references: [id])
  lineItems         InvoiceLineItem[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceLineItem {
  id            String   @id @default(cuid())
  invoiceId     String
  description   String
  quantity      Float    @default(1)
  unitPrice     Float    @default(0)
  total         Float    @default(0)
  createdAt     DateTime @default(now())

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum InvoiceType {
  ESTIMATE
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  PAID
  OVERDUE
  CANCELLED
}

// ─── Promo Codes ────────────────────────────────────────────
model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  discount    Float    @default(0) // percentage
  maxUses     Int      @default(100)
  currentUses Int     @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}
